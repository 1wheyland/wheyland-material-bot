APP_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/materialbot?sslmode=verify-full
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_CALLBACK_URL=http://localhost:3000/api/oauth/callback
# Exact encoded account ID from query { account { id name } }
JOBBER_ACCOUNT_ID=
JOBBER_GRAPHQL_VERSION=2026-05-12
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Three independent secrets. Generate each locally; never paste tokens into chat.
ADMIN_SECRET=
CRON_SECRET=
# Base64 encoding of 32 random bytes
TOKEN_ENCRYPTION_KEY=
# Enable only after completing the setup acceptance checklist.
ENABLE_EVENT_WRITES=false
MAX_EVENT_DESCRIPTION_CHARS=20000
MAX_SOURCE_CHARS=120000
